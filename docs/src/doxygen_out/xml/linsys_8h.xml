      <memberdef kind="function" id="linsys_8h_1a24229ab88459885462fcc7fa6759467f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="scs__types_8h_1a23c48a83ce0c58783595ad45ffcaf76b" kindref="member">scs_int</ref></type>
        <definition>scs_int scs_solve_lin_sys</definition>
        <argsstring>(ScsLinSysWork *w, scs_float *b, const scs_float *s, scs_float tol)</argsstring>
        <name>scs_solve_lin_sys</name>
        <param>
          <type><ref refid="scs_8h_1a0f7cde25a6dc679e4612255a4bdbe6c1" kindref="member">ScsLinSysWork</ref> *</type>
          <declname>w</declname>
        </param>
        <param>
          <type><ref refid="scs__types_8h_1ad37836e6404bb2c3ae8adcc6290699b9" kindref="member">scs_float</ref> *</type>
          <declname>b</declname>
        </param>
        <param>
          <type>const <ref refid="scs__types_8h_1ad37836e6404bb2c3ae8adcc6290699b9" kindref="member">scs_float</ref> *</type>
          <declname>s</declname>
        </param>
        <param>
          <type><ref refid="scs__types_8h_1ad37836e6404bb2c3ae8adcc6290699b9" kindref="member">scs_float</ref></type>
          <declname>tol</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Solves the linear system as required by SCS at each iteration:      <formula id="0">\[   \begin{bmatrix}
   (R_x + P) &amp; A^\top \\
    A   &amp;  -R_y \\
   \end{bmatrix} x = b
\]</formula></para>
<para>for <computeroutput>x</computeroutput>, where <computeroutput>diag(R_x, R_y) = R</computeroutput>. Overwrites <computeroutput>b</computeroutput> with result.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>w</parametername>
</parameternamelist>
<parameterdescription>
<para>Linear system private workspace. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>b</parametername>
</parameternamelist>
<parameterdescription>
<para>Right hand side, contains solution at the end. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>s</parametername>
</parameternamelist>
<parameterdescription>
<para>Contains warm-start (may be NULL). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>tol</parametername>
</parameternamelist>
<parameterdescription>
<para>Tolerance required for the system solve. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>status != 0 indicates failure. </para>
</simplesect>
</para>
        </detaileddescription>
